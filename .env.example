# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/veyra
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Shopify ────────────────────────────────────────────────
SHOPIFY_API_KEY=your-api-key
SHOPIFY_API_SECRET=your-api-secret
SHOPIFY_SCOPES=read_checkouts,write_checkouts,read_orders,write_orders,read_customers,write_customers,read_products,read_price_rules,write_price_rules,read_discounts,write_discounts
SHOPIFY_APP_URL=https://your-app.example.com
SHOPIFY_WEBHOOK_SECRET=your-webhook-secret

# ─── Stripe ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx

# ─── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ─── SMS (Twilio) ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+1234567890

# ─── WhatsApp (Twilio) ─────────────────────────────────────
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ─── App Config ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
APP_SECRET=change-this-to-a-random-secret
ENCRYPTION_KEY=32-byte-hex-key-for-token-encryption

# ─── Feature Flags ──────────────────────────────────────────
ENABLE_SMS=false
ENABLE_WHATSAPP=false
ENABLE_HOLDOUT_GROUPS=true
